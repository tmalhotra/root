# ─────────────────────────────────────────────────────────────────────────────
# Dunes + Tides — environment variables
#
# Copy this file to `.env.local` and fill in real values to connect OwnerRez.
# WITHOUT these, the app runs on built-in 2026-season SEED DATA — so you can
# develop the entire UI with no credentials. See docs/OWNERREZ.md.
#
# The app connects ONLY to OwnerRez. Airbnb (native) and VRBLI (iCal) are wired
# into OwnerRez upstream, so their bookings arrive through the OwnerRez API too.
# ─────────────────────────────────────────────────────────────────────────────

# --- OwnerRez API (Personal Access Token auth) -------------------------------
# Create a token at: OwnerRez → Settings → API Access → Create Access Token.
# Auth is HTTP Basic: username = your OwnerRez login email, password = the token.
OWNERREZ_EMAIL=
OWNERREZ_ACCESS_TOKEN=

# --- Duplex listing → unit mapping -------------------------------------------
# "123 East Herbert St" is three OwnerRez properties (Tides, Dunes, whole house).
# Map each OwnerRez property_id to its unit so bookings land in the right lane.
# Find the ids via GET /v2/properties or the OwnerRez property URL.
OWNERREZ_PROPERTY_ID_TIDES=
OWNERREZ_PROPERTY_ID_DUNES=
OWNERREZ_PROPERTY_ID_WHOLE=

# Set to "true" to force seed data even if credentials are present (handy for
# demos and screenshots). Defaults to false.
USE_SEED_DATA=false
